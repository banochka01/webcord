generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  CIRCLE_VIDEO
  FILE
}

enum ChannelType {
  TEXT
  VOICE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DirectConversationType {
  DIRECT
  GROUP
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

enum GuildMemberRole {
  MEMBER
  MODERATOR
  ADMIN
  OWNER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  MESSAGE
  DIRECT_MESSAGE
}

enum ModerationActionType {
  MUTE
  UNMUTE
  BAN
  UNBAN
  REPORT_REVIEWED
  REPORT_RESOLVED
  REPORT_DISMISSED
}

model User {
  id                            Int                        @id @default(autoincrement())
  username                      String                     @unique
  password                      String
  role                          UserRole                   @default(USER)
  displayName                   String?
  avatarUrl                     String?
  bannerUrl                     String?
  bio                           String                     @default("")
  statusText                    String                     @default("Online")
  favoriteTrack                 String                     @default("")
  favoriteTrackUrl              String?
  favoriteTrackName             String?
  accentColor                   String                     @default("#7c5cff")
  mutedUntil                    DateTime?
  bannedUntil                   DateTime?
  messages                      Message[]
  directMessages                DirectMessage[]
  messageReactions              MessageReaction[]
  directMessageReactions        DirectMessageReaction[]
  sentFriendRequests            FriendRequest[]            @relation("FriendRequestSender")
  receivedFriendRequests        FriendRequest[]            @relation("FriendRequestReceiver")
  friendshipsLeft               Friendship[]               @relation("FriendshipLeftUser")
  friendshipsRight              Friendship[]               @relation("FriendshipRightUser")
  directConversationsLeft       DirectConversation[]       @relation("DirectConversationLeftUser")
  directConversationsRight      DirectConversation[]       @relation("DirectConversationRightUser")
  ownedDirectConversations      DirectConversation[]       @relation("DirectConversationOwner")
  directConversationMemberships DirectConversationMember[]
  stories                       Story[]
  storyViews                    StoryView[]
  blockedUsers                  UserBlock[]                @relation("UserBlocksFrom")
  blockedBy                     UserBlock[]                @relation("UserBlocksTo")
  reportsMade                   ModerationReport[]         @relation("ReportReporter")
  reportsTargetingUser          ModerationReport[]         @relation("ReportTargetUser")
  reportsResolved               ModerationReport[]         @relation("ReportResolver")
  moderationActions             ModerationAction[]         @relation("ModerationActor")
  moderationTargets             ModerationAction[]         @relation("ModerationTargetUser")
  messageBookmarks              MessageBookmark[]
  messageEditHistory            MessageEditHistory[]
  pushSubscriptions             PushSubscription[]
  devicePushTokens              DevicePushToken[]
  callRecordsCreated            CallRecord[]               @relation("CallRecordCaller")
  callRecordMemberships         CallRecordParticipant[]
  activityEvents                ActivityEvent[]            @relation("ActivityRecipient")
  activityActions               ActivityEvent[]            @relation("ActivityActor")
  pollsCreated                  Poll[]
  pollVotes                     PollVote[]
  communityEventsCreated        CommunityEvent[]
  communityEventRsvps           CommunityEventRsvp[]
  guildInvitesCreated           GuildInvite[]
  guildMemberships              GuildMember[]
  guildAuditActions             GuildAuditLog[]            @relation("GuildAuditActor")
  guildAuditTargets             GuildAuditLog[]            @relation("GuildAuditTarget")
  scheduledMessages             ScheduledMessage[]
  sessions                      UserSession[]
  clientErrorReports            ClientErrorReport[]
  channelPermissions            ChannelPermission[]
  createdAt                     DateTime                   @default(now())
}

model UserSession {
  id         String              @id @default(uuid())
  userId     Int
  secretHash String
  deviceName String
  platform   String              @default("WEB")
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime            @default(now())
  lastSeenAt DateTime            @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  errors     ClientErrorReport[]

  @@index([userId, revokedAt, lastSeenAt])
  @@index([expiresAt])
}

model ClientErrorReport {
  id          Int          @id @default(autoincrement())
  userId      Int?
  sessionId   String?
  platform    String
  appVersion  String
  message     String
  stack       String?
  context     Json?
  fingerprint String
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session     UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([fingerprint, createdAt])
  @@index([userId, createdAt])
  @@index([resolvedAt, createdAt])
}

model Guild {
  id          Int              @id @default(autoincrement())
  name        String
  description String           @default("")
  iconUrl     String?
  bannerUrl   String?
  accentColor String           @default("#7c5cff")
  channels    Channel[]
  events      CommunityEvent[]
  invites     GuildInvite[]
  members     GuildMember[]
  auditLog    GuildAuditLog[]
  createdAt   DateTime         @default(now())
}

model GuildMember {
  id        Int             @id @default(autoincrement())
  guildId   Int
  userId    Int
  role      GuildMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  guild     Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId, joinedAt])
  @@index([guildId, role])
}

model GuildAuditLog {
  id           Int      @id @default(autoincrement())
  guildId      Int
  actorId      Int?
  targetUserId Int?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actor        User?    @relation("GuildAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("GuildAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([targetUserId, createdAt])
}

model Channel {
  id                Int                 @id @default(autoincrement())
  name              String
  type              ChannelType         @default(TEXT)
  guildId           Int
  guild             Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  messages          Message[]
  polls             Poll[]
  scheduledMessages ScheduledMessage[]
  slowModeSeconds   Int                 @default(0)
  isPrivate         Boolean             @default(false)
  minimumRole       GuildMemberRole     @default(MEMBER)
  permissions       ChannelPermission[]
  createdAt         DateTime            @default(now())

  @@index([guildId])
}

model Message {
  id                Int                  @id @default(autoincrement())
  content           String
  attachmentUrl     String?
  attachmentType    AttachmentType?
  attachmentName    String?
  transcript        String?
  forwardedFromName String?
  pinnedAt          DateTime?
  pinnedById        Int?
  replyToId         Int?
  editedAt          DateTime?
  deletedAt         DateTime?
  silent            Boolean              @default(false)
  channelId         Int
  authorId          Int
  createdAt         DateTime             @default(now())
  channel           Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author            User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo           Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]            @relation("MessageReplies")
  reactions         MessageReaction[]
  reports           ModerationReport[]
  bookmarks         MessageBookmark[]
  editHistory       MessageEditHistory[]
  poll              Poll?

  @@index([channelId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([authorId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  messageId Int
  userId    Int
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sender     User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userOneId Int
  userTwoId Int
  createdAt DateTime @default(now())
  userOne   User     @relation("FriendshipLeftUser", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User     @relation("FriendshipRightUser", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
}

model DirectConversation {
  id                Int                        @id @default(autoincrement())
  type              DirectConversationType     @default(DIRECT)
  title             String?
  avatarUrl         String?
  ownerId           Int?
  userOneId         Int?
  userTwoId         Int?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  owner             User?                      @relation("DirectConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userOne           User?                      @relation("DirectConversationLeftUser", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo           User?                      @relation("DirectConversationRightUser", fields: [userTwoId], references: [id], onDelete: Cascade)
  members           DirectConversationMember[]
  messages          DirectMessage[]
  callRecords       CallRecord[]
  polls             Poll[]
  scheduledMessages ScheduledMessage[]

  @@unique([userOneId, userTwoId])
  @@index([updatedAt])
  @@index([type, updatedAt])
  @@index([ownerId])
}

model DirectConversationMember {
  id             Int                @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String             @default("MEMBER")
  joinedAt       DateTime           @default(now())
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id                Int                     @id @default(autoincrement())
  content           String
  attachmentUrl     String?
  attachmentType    AttachmentType?
  attachmentName    String?
  transcript        String?
  forwardedFromName String?
  pinnedAt          DateTime?
  pinnedById        Int?
  replyToId         Int?
  editedAt          DateTime?
  deletedAt         DateTime?
  readAt            DateTime?
  silent            Boolean                 @default(false)
  conversationId    Int
  authorId          Int
  createdAt         DateTime                @default(now())
  conversation      DirectConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author            User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo           DirectMessage?          @relation("DirectMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           DirectMessage[]         @relation("DirectMessageReplies")
  reactions         DirectMessageReaction[]
  reports           ModerationReport[]
  bookmarks         MessageBookmark[]
  editHistory       MessageEditHistory[]
  poll              Poll?

  @@index([conversationId, createdAt])
  @@index([conversationId, pinnedAt])
  @@index([authorId])
  @@index([conversationId, readAt])
}

model DirectMessageReaction {
  id              Int           @id @default(autoincrement())
  emoji           String
  directMessageId Int
  userId          Int
  createdAt       DateTime      @default(now())
  directMessage   DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
  @@index([directMessageId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocksFrom", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksTo", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ModerationReport {
  id              Int              @id @default(autoincrement())
  reporterId      Int
  targetType      ReportTargetType
  targetUserId    Int?
  messageId       Int?
  directMessageId Int?
  reason          String
  details         String           @default("")
  status          ReportStatus     @default(OPEN)
  resolvedById    Int?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  reporter        User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser      User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  message         Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  directMessage   DirectMessage?   @relation(fields: [directMessageId], references: [id], onDelete: SetNull)
  resolvedBy      User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
  @@index([messageId])
  @@index([directMessageId])
}

model ModerationAction {
  id           Int                  @id @default(autoincrement())
  actorId      Int
  targetUserId Int?
  action       ModerationActionType
  reason       String               @default("")
  metadata     Json?
  createdAt    DateTime             @default(now())
  actor        User                 @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser   User?                @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model Story {
  id              Int            @id @default(autoincrement())
  caption         String         @default("")
  mediaUrl        String
  mediaType       StoryMediaType @default(IMAGE)
  musicUrl        String?
  musicTitle      String         @default("")
  musicArtist     String         @default("")
  musicAttachment String         @default("")
  authorId        Int
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views           StoryView[]

  @@index([expiresAt])
  @@index([authorId, createdAt])
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  viewerId Int
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model ChannelPermission {
  id        Int      @id @default(autoincrement())
  channelId Int
  userId    Int
  canView   Boolean  @default(true)
  canPost   Boolean  @default(true)
  canManage Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId, canView])
}

model MessageBookmark {
  id              Int            @id @default(autoincrement())
  userId          Int
  messageId       Int?
  directMessageId Int?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@unique([userId, directMessageId])
  @@index([userId, createdAt])
}

model MessageEditHistory {
  id              Int            @id @default(autoincrement())
  editorId        Int
  messageId       Int?
  directMessageId Int?
  previousContent String
  createdAt       DateTime       @default(now())
  editor          User           @relation(fields: [editorId], references: [id], onDelete: Cascade)
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([directMessageId, createdAt])
  @@index([editorId, createdAt])
}

model PushSubscription {
  id                Int      @id @default(autoincrement())
  userId            Int
  endpoint          String   @unique
  p256dh            String
  auth              String
  notificationMode  String   @default("all")
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String   @default("22:00")
  quietHoursEnd     String   @default("08:00")
  timezoneOffset    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DevicePushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("ANDROID")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model CallRecord {
  id              String                  @id
  conversationId  Int
  callerId        Int
  title           String
  video           Boolean                 @default(false)
  status          String                  @default("RINGING")
  startedAt       DateTime                @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int                     @default(0)
  conversation    DirectConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller          User                    @relation("CallRecordCaller", fields: [callerId], references: [id], onDelete: Cascade)
  participants    CallRecordParticipant[]

  @@index([conversationId, startedAt])
  @@index([callerId, startedAt])
  @@index([status, startedAt])
}

model CallRecordParticipant {
  id       Int        @id @default(autoincrement())
  callId   String
  userId   Int
  joinedAt DateTime?
  leftAt   DateTime?
  call     CallRecord @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId, callId])
}

model ActivityEvent {
  id              Int       @id @default(autoincrement())
  userId          Int
  actorId         Int?
  kind            String
  title           String
  body            String    @default("")
  channelId       Int?
  conversationId  Int?
  messageId       Int?
  directMessageId Int?
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation("ActivityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor           User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, kind, createdAt])
}

model Poll {
  id              Int                 @id @default(autoincrement())
  question        String
  allowsMultiple  Boolean             @default(false)
  anonymous       Boolean             @default(false)
  closesAt        DateTime?
  createdById     Int
  channelId       Int?
  conversationId  Int?
  messageId       Int?                @unique
  directMessageId Int?                @unique
  createdAt       DateTime            @default(now())
  createdBy       User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  channel         Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation    DirectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  directMessage   DirectMessage?      @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  options         PollOption[]

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
}

model PollOption {
  id       Int        @id @default(autoincrement())
  pollId   Int
  label    String
  position Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@unique([pollId, position])
  @@index([pollId])
}

model PollVote {
  id        Int        @id @default(autoincrement())
  optionId  Int
  userId    Int
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId, createdAt])
}

model CommunityEvent {
  id          Int                  @id @default(autoincrement())
  guildId     Int
  creatorId   Int
  title       String
  description String               @default("")
  location    String               @default("")
  coverUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  guild       Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator     User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps       CommunityEventRsvp[]

  @@index([guildId, startsAt])
}

model CommunityEventRsvp {
  id        Int            @id @default(autoincrement())
  eventId   Int
  userId    Int
  status    String         @default("INTERESTED")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model GuildInvite {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  guildId   Int
  creatorId Int
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

model ScheduledMessage {
  id             Int                 @id @default(autoincrement())
  senderId       Int
  channelId      Int?
  conversationId Int?
  content        String
  attachmentUrl  String?
  attachmentType AttachmentType?
  attachmentName String?
  replyToId      Int?
  sendAt         DateTime
  silent         Boolean             @default(false)
  status         String              @default("PENDING")
  failureReason  String              @default("")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel        Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation   DirectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([senderId, createdAt])
}
